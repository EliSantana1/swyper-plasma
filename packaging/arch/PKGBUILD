# Maintainer: EliSantana1 <24918106+EliSantana1@users.noreply.github.com>
# The plugin itself is built on the installing machine by a pacman hook (like DKMS),
# so it always matches that machine's exact KWin build.
pkgname=swyper-plasma
pkgver=1.0.0
pkgrel=1
pkgdesc="Swyper: touchpad gestures for KDE Plasma with KWin's native animations"
arch=('any')
url="https://github.com/EliSantana1/swyper-plasma"
license=('GPL-3.0-or-later')
depends=('kwin>=6.8' 'qt6-base' 'qt6-declarative' 'kcoreaddons' 'kconfig' 'kcmutils' 'kirigami' 'ki18n'
         'cmake' 'extra-cmake-modules' 'gcc' 'make' 'binutils' 'vulkan-headers')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('81a5195b43deca2eb79447f2c44cf960250ca4a7cfc7e08407a1425981fd7911')

package() {
    local src="$srcdir/$pkgname-$pkgver"
    install -d "$pkgdir/usr/src/$pkgname"
    install -m644 "$src/CMakeLists.txt" "$pkgdir/usr/src/$pkgname/"
    cp -r --no-preserve=ownership "$src/src" "$pkgdir/usr/src/$pkgname/"
    find "$pkgdir/usr/src/$pkgname" -type d -exec chmod 755 {} + -o -type f -exec chmod 644 {} +
    install -Dm755 "$src/packaging/arch/rebuild" "$pkgdir/usr/lib/$pkgname/rebuild"
    install -Dm644 "$src/packaging/arch/build.hook" "$pkgdir/usr/share/libalpm/hooks/90-$pkgname-build.hook"
    install -Dm644 "$src/packaging/arch/remove.hook" "$pkgdir/usr/share/libalpm/hooks/90-$pkgname-remove.hook"
}
